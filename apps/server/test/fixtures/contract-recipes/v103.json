    "corpus_file": "0598-grilled-pork-chops.yaml",
    "recipe": {
      "title": "Grilled Pork Chops",
      "servings": "SERVES 4",
      "prep_notes": "Rib loin chops are our top choice for their big flavor and juiciness. The spice rub adds a lot of flavor for very little effort, but the chops can also be seasoned with pepper alone just before grilling. If the pork is enhanced, do not brine and add 2 teaspoons salt along with spice rub or pepper.",
      "ingredients": [
        {
          "items": [
            {
              "raw": "3 tablespoons salt",
              "amounts": [
                {
                  "measure": "volume",
                  "quantity": "3",
                  "unit": "tablespoon",
                  "approximate": false,
                  "primary": true
                }
              ],
              "item": "salt"
            },
            {
              "raw": "3 tablespoons sugar",
              "amounts": [
                {
                  "measure": "volume",
                  "quantity": "3",
                  "unit": "tablespoon",
                  "approximate": false,
                  "primary": true
                }
              ],
              "item": "sugar"
            },
            {
              "raw": "4 (12-ounce) bone-in pork rib or center-cut chops, 1½ inches thick, trimmed",
              "amounts": [
                {
                  "measure": "count",
                  "quantity": "4",
                  "approximate": false,
                  "primary": true
                }
              ],
              "item": "(12-ounce) bone-in pork rib or center-cut chops",
              "prep": "1 1/2 inches thick, trimmed"
            },
            {
              "raw": "1 recipe Basic Spice Rub for Pork Chops (recipe follows) or 2 teaspoons pepper",
              "amounts": [
                {
                  "measure": "count",
                  "quantity": "1",
                  "unit": "recipe",
                  "approximate": false,
                  "primary": true
                }
              ],
              "item": "Basic Spice Rub for Pork Chops",
              "prep": "recipe follows; or 2 teaspoons pepper"
            }
          ]
        }
      ],
      "steps": [
        {
          "number": 1,
          "text": "Dissolve salt and sugar in 1½ quarts cold water in large container. Submerge chops in brine, cover, and refrigerate for 30 minutes to 1 hour. Remove chops from brine and pat dry with paper towels. Rub chops with spice rub."
        },
        {
          "number": 2,
          "text": "Open bottom vent completely. Light large chimney starter filled with charcoal briquettes (6 quarts). When top coals are partially covered with ash, pour two-thirds evenly over grill, then pour remaining coals over half of grill. Set cooking grate in place, cover, and open lid vent completely. Heat grill until hot, about 5 minutes."
        },
        {
          "number": 3,
          "text": "Turn all burners to high, cover, and heat grill until hot, about 15 minutes. Leave primary burner on high and turn off other burner(s)."
        },
        {
          "number": 3,
          "text": "Clean and oil cooking grate. Place chops on hotter side of grill and cook (covered if using gas) until browned on both sides, 4 to 8 minutes. Move chops to cool side of grill, cover, and continue to cook, turning once, until meat registers 145 degrees, 7 to 9 minutes longer. Transfer chops to serving platter, tent loosely with aluminum foil, and let rest for 5 to 10 minutes. Serve."
        }
      ],
      "subsections": [
        {
          "title": "Basic Spice Rub for Pork Chops",
          "kind": "variation",
          "servings": "MAKES ¼ CUP",
          "ingredients": [
            {
              "items": [
                {
                  "raw": "1 tablespoon ground cumin",
                  "amounts": [
                    {
                      "measure": "volume",
                      "quantity": "1",
                      "unit": "tablespoon",
                      "approximate": false,
                      "primary": true
                    }
                  ],
                  "item": "ground cumin"
                },
                {
                  "raw": "1 tablespoon chili powder",
                  "amounts": [
                    {
                      "measure": "volume",
                      "quantity": "1",
                      "unit": "tablespoon",
                      "approximate": false,
                      "primary": true
                    }
                  ],
                  "item": "chili powder"
                },
                {
                  "raw": "1 tablespoon curry powder",
                  "amounts": [
                    {
                      "measure": "volume",
                      "quantity": "1",
                      "unit": "tablespoon",
                      "approximate": false,
                      "primary": true
                    }
                  ],
                  "item": "curry powder"
                },
                {
                  "raw": "2 teaspoons packed brown sugar",
                  "amounts": [
                    {
                      "measure": "volume",
                      "quantity": "2",
                      "unit": "teaspoon",
                      "approximate": false,
                      "primary": true
                    }
                  ],
                  "item": "packed brown sugar"
                },
                {
                  "raw": "1 teaspoon pepper",
                  "amounts": [
                    {
                      "measure": "volume",
                      "quantity": "1",
                      "unit": "teaspoon",
                      "approximate": false,
                      "primary": true
                    }
                  ],
                  "item": "pepper"
                }
              ]
            }
          ],
          "steps": []
        }
      ]
    }
