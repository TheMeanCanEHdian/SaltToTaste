                  "unit": "tablespoon",
                  "approximate": false,
                  "primary": true
                }
              ],
              "item": "sour cream"
            },
            {
              "raw": "2½ cups (12½ ounces) unbleached all-purpose flour, plus extra for the work surface",
              "amounts": [
                {
                  "measure": "volume",
                  "quantity": "2 1/2",
                  "unit": "cup",
                  "approximate": false,
                  "primary": true
                },
                {
                  "measure": "weight",
                  "quantity": "12 1/2",
                  "unit": "ounce",
                  "approximate": false,
                  "primary": false
                }
              ],
              "item": "unbleached all-purpose flour",
              "prep": "plus extra for the work surface"
            },
            {
              "raw": "1 tablespoon sugar",
              "amounts": [
                {
                  "measure": "volume",
                  "quantity": "1",
                  "unit": "tablespoon",
                  "approximate": false,
                  "primary": true
                }
              ],
              "item": "sugar"
            },
            {
              "raw": "1 teaspoon table salt",
              "amounts": [
                {
                  "measure": "volume",
                  "quantity": "1",
                  "unit": "teaspoon",
                  "approximate": false,
                  "primary": true
                }
              ],
              "item": "table salt"
            },
            {
              "raw": "16 tablespoons (2 sticks) unsalted butter, cut into ¼-inch pieces and frozen for 10 to 15 minutes",
              "amounts": [
